#!/usr/bin/env bash
#
# Links all .dotfiles/files to home folder.

set -eu

echo -e "linking dotfiles:\n"

cd "$HOME/.dotfiles/files"

# Enable dotglob to match hidden files/directories
shopt -s dotglob

for file in *; do
  [ "${file:0:1}" = "." ] && ln_name="$file" || ln_name=".$file"
  link="$HOME/$ln_name"
  if [ -f "$link" ] || [ -d "$link" ]; then
    echo "$link exists. Backing it up into dotfiles_backup."
    mkdir -p "$HOME/dotfiles_backup"
    mv "$link" "$HOME/dotfiles_backup/$file"
  fi

  ln -sfv "$HOME/.dotfiles/files/$file" "$link"
done

echo -e "\ndone."
